{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignSchema",
  "description": "Validation schema for Roko's Tasks campaign definitions (game-design §4.7).",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "easy",
        "medium",
        "hard",
        "expert",
        "impossible"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string",
            "enum": [
              "none",
              "lines",
              "keys"
            ],
            "description": "How the player supplies input to the program."
          },
          "check_script": {
            "type": "string",
            "minLength": 1,
            "description": "Python that defines check(game) and plays the program. The only thing that grades a stage."
          },
          "reference_program": {
            "type": "string",
            "minLength": 1,
            "description": "A program that passes the stage's check script."
          },
          "broken_program": {
            "type": "string",
            "minLength": 1,
            "description": "A program that gets the stage's new feature subtly wrong, so the check script must fail it."
          }
        },
        "required": [
          "stage",
          "prompt",
          "input",
          "check_script",
          "reference_program",
          "broken_program"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "title",
    "difficulty",
    "stages"
  ],
  "additionalProperties": false
}
