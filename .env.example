# File: .env.example
# Description: Example environment variables with safe local defaults.
# Author(s): Tyler Black

# Flask application secret key
SECRET_KEY=change-me-locally

# PostgreSQL credentials and port
POSTGRES_USER=rokos
POSTGRES_PASSWORD=rokos
POSTGRES_DB=rokos_tasks
DB_HOST_PORT=5433

# Database connection URL for web container
DATABASE_URL=postgresql+psycopg://rokos:rokos@db:5432/rokos_tasks

# LLM mode: fake | replay | live (never commit live keys)
LLM_MODE=fake
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_DAILY_BUDGET_USD=3
LLM_TOTAL_BUDGET_USD=70
