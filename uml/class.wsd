@startuml class
' File: class.wsd
' Description: Class diagram of the model (domain) classes for Roko's Tasks.
'     Routes, services, repositories, and framework classes are excluded.
' Author(s): <team member names>

hide empty members
skinparam classAttributeIconSize 0

enum Difficulty {
    BEGINNER
    EASY
    MEDIUM
    HARD
    EXPERT
    IMPOSSIBLE
    --
    stage_count: int
    seconds_per_stage: int
    starting_lives: int
    multiplier: float
}

enum CampaignSource {
    SEED
    GENERATED
}

enum CampaignStatus {
    VALIDATED
    QUARANTINED
    RETIRED
}

enum RunStatus {
    ACTIVE
    WON
    LOST
}

enum FailureKind {
    WRONG_OUTPUT
    RUNTIME_ERROR
    SYNTAX_ERROR
    TIMEOUT
}

class User {
    id: int
    username: str
    password_hash: str
    created_at: datetime
    is_active: bool
    +check_password(password: str): bool
}

class Campaign {
    id: int
    title: str
    difficulty: Difficulty
    source: CampaignSource
    status: CampaignStatus
    created_at: datetime
    +stage(number: int): Stage
}

class Stage {
    id: int
    number: int
    prompt: str
    input_format: str
    output_format: str
    starter_code: str | None
    +sample_cases(): list[TestCase]
    +hidden_cases(): list[TestCase]
}

class TestCase {
    id: int
    input_text: str
    expected_output: str
    is_sample: bool
}

class GameRun {
    id: int
    lives: int
    current_stage_number: int
    status: RunStatus
    score: int
    bonus_life_used: bool
    started_at: datetime
    stage_deadline: datetime
    +lose_life(): None
    +advance_stage(code: str, points: int): None
    +is_over(): bool
}

class Checkpoint {
    id: int
    stage_number: int
    code: str
    saved_at: datetime
}

class Submission {
    id: int
    code: str
    passed: bool
    failure_kind: FailureKind | None
    failed_test_index: int | None
    seconds_remaining: int
    submitted_at: datetime
}

class LlmUsageRecord <<optional US11>> {
    id: int
    purpose: str
    model: str
    tokens_in: int
    tokens_out: int
    estimated_cost: float
    created_at: datetime
}

User "1" -- "0..*" GameRun : plays >
GameRun "0..*" --> "1" Campaign : follows >
Campaign "1" *-- "1..*" Stage
Stage "1" *-- "1..*" TestCase
GameRun "1" *-- "0..*" Checkpoint
GameRun "1" *-- "0..*" Submission
Submission "0..*" --> "1" Stage : answers >

Campaign ..> Difficulty
Campaign ..> CampaignSource
Campaign ..> CampaignStatus
GameRun ..> RunStatus
Submission ..> FailureKind

@enduml
